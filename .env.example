# ==============================================================================
# YouTube Shorts Auto Creator - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env on your secure server backend.
# NEVER commit .env to GitHub or bundle secrets into frontend client code.

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used for AI research, viral hook scriptwriting, and TTS voice audio.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Official Google OAuth 2.0 Credentials (YouTube Data API v3)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> Web application
# Scopes used:
#  - https://www.googleapis.com/auth/youtube.upload
#  - https://www.googleapis.com/auth/youtube.readonly
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# GOOGLE_REDIRECT_URI: Exact authorized redirect URI configured in Google Cloud Console
# Must match: https://<your-backend-domain>/api/youtube/callback
GOOGLE_REDIRECT_URI="https://ais-dev-hmzxjhb6oabtwfvt7amhpw-743842357149.asia-east1.run.app/api/youtube/callback"

# YOUTUBE_API_KEY: Optional Google Cloud API Key for public data queries
YOUTUBE_API_KEY=""

# ------------------------------------------------------------------------------
# Server & CORS Configuration
# ------------------------------------------------------------------------------
PORT=3000

# APP_URL: Public URL of your deployed backend service (e.g. Cloud Run, Render, Railway)
APP_URL="https://ais-dev-hmzxjhb6oabtwfvt7amhpw-743842357149.asia-east1.run.app"

# FRONTEND_URL: URL of your frontend (GitHub Pages)
FRONTEND_URL="https://gaugehouse1998-debug.github.io/youtube-shorts-auto-creator"

# VIDEO_RETENTION_HOURS: Hours before temporary video generation files are purged
VIDEO_RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# Frontend Environment Variable (Vite / GitHub Pages)
# ------------------------------------------------------------------------------
# Injected during GitHub Actions build:
VITE_API_BASE_URL="https://ais-dev-hmzxjhb6oabtwfvt7amhpw-743842357149.asia-east1.run.app"
